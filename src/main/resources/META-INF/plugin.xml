<idea-plugin require-restart="true">
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                id="com.openlinker.settings"
                displayName="OpenLinker"
                parentId="tools"
                instance="com.openlinker.settings.OpenLinkerConfigurable"/>
    </extensions>

    <actions>
        <action
                id="com.openlinker.OpenLinkerPopupAction"
                class="com.openlinker.OpenLinkerPopupAction"
                text="OpenLinker"
                description="Show OpenLinker popup"
                icon="/icons/openlinkerBrowserOpen.svg">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>
        <action
                id="com.openlinker.OpenCustomUrlAction"
                class="com.openlinker.OpenCustomUrlAction"
                text="OpenLinker"
                description="Open OpenLinker using configured rules"
                icon="/icons/openlinkerBrowserOpen.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
